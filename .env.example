# Copy to .env and fill in real values. NEVER commit .env.

# Groq API key for the AI Financial Analyst (backend only).
# Without it, financial features still run; the analyst answers report the
# missing key and classification falls back to deterministic rules + review queue.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Allow rules-only classification everywhere the key is absent.
ENABLE_LLM_CLASSIFICATION=true