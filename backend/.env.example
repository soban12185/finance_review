# Copy to .env and fill in real values. NEVER commit .env.

# --- PostgreSQL ---------------------------------------------------------
# The application uses a single database supplied through DATABASE_URL.
DATABASE_URL=postgresql+psycopg://finz:finz@localhost:5432/finz

# --- Groq (AI Financial Analyst + classification assistance) ------------
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Groq SDK base URL. The SDK appends "/openai/v1/<resource>" itself, so set
# this to the host root only. Do NOT include "/openai/v1" here.
GROQ_BASE_URL=https://api.groq.com

# --- Classification tuning ----------------------------------------------
# Rules are used first. If rule confidence is below this, the LLM is asked.
LLM_CLASSIFICATION_THRESHOLD=0.80
# Final confidence below this sends the transaction to the Review Queue.
REVIEW_CONFIDENCE_THRESHOLD=0.92
# Set to false to disable LLM classification entirely (rules only).
ENABLE_LLM_CLASSIFICATION=true

# --- Variance / materiality ----------------------------------------------
VARIANCE_MATERIALITY_PERCENT=10.0
VARIANCE_MATERIALITY_ABS_CENTS=50000

# --- CORS ----------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Optional: auto-seed the dataset on first start -----------------------
# SEED_DATASET_PATH=/app/data/NYC Restaurant Co. - Raw Transactions.xlsx

# --- Misc ------------------------------------------------------------------
LOG_LEVEL=INFO